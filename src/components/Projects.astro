---
const projects = [
  {
    name: "Pantaloons",
    tags: ["Astro"],
    link: "https://pantaloonsmusic.com/",
    description: `Landing page for the band Pantaloons, built with Astro and featuring Google Calendar integration for upcoming gig dates.`,
    year: "2025",
  },
  {
    name: "Green light district",
    tags: ["React", "Node.js", "Express", "Mediasoup", "WebRTC", "P2P Streaming"],
    link: "https://ursus.amarkezic.xyz/viewer",
    description: `P2P streaming app built for a live dance performance where dancers acted as live streamers and the audience viewed the performance through their phones. Built with Mediasoup for peer-to-peer streaming, featuring stream switching, live comments, and likes.`,
    year: "2025",
  },
  {
    name: "Money Matters",
    tags: ["Blazor", "C#", "SQL Server"],
    link: "https://money-matters.amarkezic.xyz",
    description: `Financial management software for small businesses. Features an intuitive accounting dashboard, dark/light mode, and transparent reporting tools.`,
    year: "2024",
  },
  {
    name: "Scout GPT",
    tags: ["Angular", "Typescript", "AWS", "Amplify", "ChatGPT"],
    link: "https://app.gpt-scout.com/",
    description: `Football scouting app powered by Openai's GPT-3.5`,
    year: "2023",
  },
];
---

<p class="text-xs mb-4">
  Browse my personal projects, a curated collection of my creative endeavors.
  Explore my approach to various creative pursuits.
</p>
<div class="flex flex-col gap-4">
  {
    projects.map((x) => (
      <div class="flex flex-col gap-1 border-b border-b-slate-50">
        <h5 class="text-xl font-bold">
          <a href={x.link} class="hover:underline" target="_blank">
            {x.name}
          </a>
        </h5>
        <p class="text-md">{x.year}</p>
        <div class="flex gap-2">
          {x.tags.map((tag) => (
            <span class="bg-blue-100 text-blue-800 text-xs font-medium mr-2 px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300 whitespace-nowrap">
              {tag}
            </span>
          ))}
        </div>
        <div class="mb-4">
          {x.description && (
            <>
              <h5 class="text-lg font-bold">Description:</h5>
              <p class="text-xs leading-relaxed">{x.description}</p>
            </>
          )}
        </div>
      </div>
    ))
  }
</div>
